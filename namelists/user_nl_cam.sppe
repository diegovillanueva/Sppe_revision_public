!----------------------------------------------------------
! Microphysics revision 
!----------------------------------------------------------

factor_HM = 0 ! disable hallet-mossop
onoff_sip = .false. 

depr_point_frz = .false.      ! avoid solubility effect depressing freezing 


enable_nimax = .false.              ! as PUMAS paper 2.21, but omiting Ni cap to 100/cm3
limfacdu = 0.05                     ! max. aerosol fraction as INP (PUMAS paper 2.22)

micro_mg_num_steps = 8               ! as suggested in 10.1029/2021MS002776
naai_het_also_in_mpc = .false.       ! no leak from cirrus to mpc

hclas_du_dep = 0.0  ! only immersion freezing of dust is allowed
hclas_du_cnt = 0.0                      
hclas_bc_imm = 0.0                      
hclas_bc_dep = 0.0                      
hclas_bc_cnt = 0.0                      

onoff_contact_freezing = .false.       ! legacy contact freezing
rain_freeze = .false.                   ! legacy ice from freezing rain
detrainment_ramp_liq = .true.              ! otherwise inp-unaware cloud ice


